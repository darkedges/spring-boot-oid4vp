<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.darkedges.oid4vp</groupId>
    <artifactId>oid4vp-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>oid4vp-spring-security</artifactId>
  <packaging>jar</packaging>

  <name>OpenID4VP Spring Security Integration</name>
  <description>Spring Security 7.1 integration for the Verifier role: Authentication token types, an
    AuthenticationProvider that validates a direct_post Authorization Response, request-building
    services, and an HttpSecurity DSL configurer. Deliberately format-agnostic: depends only on the
    PresentationVerifier SPI from oid4vp-core / oid4vp-verifier-core, not on any concrete format module.</description>

  <dependencies>
    <dependency>
      <groupId>com.darkedges.oid4vp</groupId>
      <artifactId>oid4vp-verifier-core</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-config</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.servlet</groupId>
      <artifactId>jakarta.servlet-api</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>

    <dependency>
      <groupId>com.darkedges.oid4vp</groupId>
      <artifactId>oid4vp-format-sdjwt-vc</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.darkedges.oid4vp</groupId>
      <artifactId>oid4vp-test-fixtures</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
